# --- Supabase (user-owned data + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shopify dev store (test mode) — the order proof ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-07

# --- Tavily (cross-shop price discovery) ---
TAVILY_API_KEY=

# --- Grok (xAI) — explains the decision, never makes it ---
# Set on the server only. Never expose to the browser.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_TIMEOUT_MS=20000

# --- Recharge (signal source; CSV seed is the fallback) ---
# POST /api/recharge/webhook reads RECHARGE_WEBHOOK_SECRET (the API client
# secret, not RECHARGE_API_KEY). Recharge sends X-Recharge-Hmac-Sha256, which
# is hex SHA-256 of client_secret concatenated with the raw body.
RECHARGE_API_KEY=
RECHARGE_WEBHOOK_SECRET=

# --- tunables ---
SIGNAL_THRESHOLD_DAYS=7
PRICE_CACHE_TTL_MINUTES=20
